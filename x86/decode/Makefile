# x86 instruction-set census
#
# Boots real Windows images under an instrumented v86 (JS/WASM PC emulator) and
# counts every executed instruction encoding, then annotates the result against
# the ref.x86asm.net encoding reference.
#
#   make               everything: images, emulator, both censuses, comparison
#   make images        uncompress the bundled disk images
#   make v86           build the instrumented emulator
#   make win98         full census for Windows 98
#   make winnt         full census for Windows NT 4.0
#   make compare       regenerate x86/COMPARISON.md from existing censuses
#   make report        re-run aggregate+annotate only (no boot)
#   make shots         boot screenshots
#   make clean         remove uncompressed images and build output
#
# The disk images ship bzip2-compressed because they are ~800 MB raw; every
# target that needs them depends on `images`, so a plain `make win98` will
# uncompress on demand.
#
# A full `make` from a clean tree takes roughly 15 minutes: ~1 min to
# uncompress, ~3 min to build the wasm, then a 4 min boot per guest.
#
# Every boot is bounded, so `make` always terminates:
#   TIMEOUT=<s>   outer watchdog per target          (default 1800)
#   SECONDS=<s>   emulated boot time to count for    (default: targets.json)
#   PHASE=<s>     snapshot the counters every s      (default: targets.json)

X86      := x86
TOOLS    := $(X86)/tools
V86_DIR  := $(X86)/decoders/v86

TARGETS  := win98 winnt

# `all` must be the default; otherwise make would pick `images`, the first
# non-pattern target in the file.
.DEFAULT_GOAL := all

.PHONY: all
all: $(TARGETS) compare
	@echo
	@echo "== done"
	@for t in $(TARGETS); do \
	    head -1 $(X86)/$$t/instructions/$$t.isa.txt; \
	done
	@echo "   $(X86)/COMPARISON.md"

# ---------------------------------------------------------------- images
# .img is derived from the committed .img.bz2
IMAGES := $(X86)/win98/images/windows98.img \
          $(X86)/winnt/images/winnt4.img

%.img: %.img.bz2
	@echo "== uncompressing $(@F) ($$(du -h $< | cut -f1) -> $$(bunzip2 -t $< 2>/dev/null; echo ok))"
	bunzip2 -k -c $< > $@.tmp && mv $@.tmp $@
	@ls -lh $@

.PHONY: images
images: $(IMAGES)

# ---------------------------------------------------------------- emulator
# v86 is vendored (x86/decoders/v86) with the win98stats instrumentation already
# applied -- see x86/decoders/v86-patch for the isolated diff against upstream
# 2f1346b0 (2026-07-05).  Only build products are missing:
#   src/rust/gen/*.rs   opcode tables, regenerated by v86's own Makefile
#   build/v86.wasm      the instrumented emulator core
#   build/libv86-debug.mjs   the JS bindings (needs Java for closure-compiler)
#
# `clang` is often only present as clang-N, so a shim is created when needed.
$(V86_DIR)/build/v86.wasm:
	@echo "== building instrumented wasm"
	@command -v clang >/dev/null || { \
	    mkdir -p /tmp/shim; \
	    ln -sf "$$(command -v clang-14 || command -v clang-15 || command -v clang-16)" /tmp/shim/clang; \
	    echo "   (shimmed clang -> $$(readlink /tmp/shim/clang))"; }
	@rustup target list --installed 2>/dev/null | grep -q wasm32-unknown-unknown \
	    || rustup target add wasm32-unknown-unknown
	cd $(V86_DIR) && PATH=/tmp/shim:$$PATH $(MAKE) with-win98stats

$(V86_DIR)/build/libv86-debug.mjs:
	cd $(V86_DIR) && $(MAKE) build/libv86-debug.mjs

.PHONY: v86
v86: $(V86_DIR)/build/v86.wasm $(V86_DIR)/build/libv86-debug.mjs

# Refresh x86/decoders/v86-patch from the vendored tree (for upstreaming or
# rebasing onto a newer v86).
.PHONY: patch
patch:
	cd $(V86_DIR) && git diff > ../v86-patch/win98stats.patch 2>/dev/null \
	    || echo "   (vendored v86 is not a git checkout; patch left unchanged)"

# ---------------------------------------------------------------- census
# One rule per target; SECONDS/PHASE can be overridden:
#   make winnt SECONDS=600 PHASE=120
SECONDS ?=
PHASE   ?=
RUNFLAGS := $(if $(SECONDS),--seconds $(SECONDS)) $(if $(PHASE),--phase-every $(PHASE))

# run.sh already watchdogs the emulator itself (boot_seconds + 180 s); this is
# the outer net that also covers image fetch, aggregate and annotate, so a
# plain `make` is guaranteed to terminate.  Override with TIMEOUT=<seconds>.
TIMEOUT ?= 1800

.PHONY: $(TARGETS)
$(TARGETS): %: images v86
	timeout --foreground -k 30 $(TIMEOUT) $(TOOLS)/run.sh $* $(RUNFLAGS)

# The two censuses each drive a full emulator boot, so they cannot share a
# process; keep them serial even under `make -j`.
.NOTPARALLEL:

# ---------------------------------------------------------------- reports
# Re-derive the artifacts from traces already on disk (no emulator needed).
.PHONY: report
report:
	@for t in $(TARGETS); do \
	    echo "== [$$t] aggregate + annotate"; \
	    python3 $(TOOLS)/aggregate.py --cumulative $(X86)/$$t/traces/*.tsv \
	        -o $(X86)/$$t/instructions/$$t.hist.tsv \
	        --title "$$t boot" \
	        --coverage $(X86)/$$t/instructions/$$t.coverage.md \
	        --opcodes  $(X86)/$$t/instructions/$$t.opcodes.txt; \
	    python3 $(TOOLS)/annotate.py $(X86)/$$t/instructions/$$t.hist.tsv \
	        --title $$t \
	        -o $(X86)/$$t/instructions/$$t.isa.txt \
	        --json $(X86)/$$t/instructions/$$t.isa.json; \
	done
	@$(MAKE) --no-print-directory compare

.PHONY: compare
compare:
	$(TOOLS)/compare.py $(TARGETS) -o $(X86)/COMPARISON.md

.PHONY: shots
shots: images v86
	@for t in $(TARGETS); do \
	    echo "== [$$t] screenshots"; \
	    node $(TOOLS)/screenshot.mjs --target $$t --shots --login </dev/null; \
	done

# ---------------------------------------------------------------- misc
.PHONY: list
list:
	$(TOOLS)/fetch_image.sh --list

# Re-compress the images after refreshing them from upstream.
.PHONY: repack
repack:
	@for f in $(IMAGES); do \
	    echo "== packing $$f"; \
	    bzip2 -9 -k -c $$f > $$f.bz2; \
	done
	@ls -lh $(X86)/*/images/*.bz2

.PHONY: clean
clean:
	rm -f $(IMAGES) $(X86)/*/images/*.img.tmp
	rm -rf $(X86)/*/traces/*.phase*.tsv

# v86 is vendored source, not a checkout -- only remove what the build made.
.PHONY: distclean
distclean: clean
	rm -rf $(V86_DIR)/build $(V86_DIR)/src/rust/gen
	rm -f $(V86_DIR)/closure-compiler*.jar
